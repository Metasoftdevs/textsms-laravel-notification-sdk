# Normalise line endings on checkout
* text=auto eol=lf

# Files excluded from the Composer dist tarball so consumers don't pay for
# bytes they will never execute against. Each entry below shaves weight from
# every `composer install` of this package.
/.github            export-ignore
/docs               export-ignore
/examples           export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.php-cs-fixer.dist.php  export-ignore
/CHANGELOG.md       export-ignore
/CONTRIBUTING.md    export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
