includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - src/Console/Commands/*.stub
    ignoreErrors:
        # Laravel facade calls return mixed by design; downstream casts are explicit.
        - identifier: missingType.generics
    treatPhpDocTypesAsCertain: false
